<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Second cloudflared LaunchDaemon — for the koho.tools tunnel.
  Runs alongside com.cloudflare.cloudflared (which serves koban.dev).
  Each daemon opens its own outbound connection to CF's edge; they don't
  conflict. Owned by us (not generated by `cloudflared service install`)
  for the same reason as the koban one: the auto-generated plist on
  cloudflared 2026.3.0+ ships without the subcommand args and idles.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cloudflare.cloudflared-tools</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/cloudflared</string>
        <string>--no-autoupdate</string>
        <string>--config</string>
        <string>/Library/Application Support/com.cloudflare.cloudflared-tools/config.yml</string>
        <string>tunnel</string>
        <string>run</string>
    </array>
    <key>StandardOutPath</key>
    <string>/Library/Logs/com.cloudflare.cloudflared-tools.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/com.cloudflare.cloudflared-tools.err.log</string>
    <key>UserName</key>
    <string>root</string>
</dict>
</plist>
